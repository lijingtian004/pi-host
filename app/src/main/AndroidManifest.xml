<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- P2C 引擎前台服务（方案 §3.5）：specialUse 类型 + API 33+ 的通知权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- P2F §4.3(a) 必修：normal 权限，安装期自动授予、无需运行时申请。
         没有它，pi 子进程调模型 API 的 socket 会被系统直接拒——spawn 修好了也过不了 P1 的「真实对话轮」判据。
         方向层 RECON-P2F §3.5 实测本清单此前只有上面 3 条，core/feature 各模块 Manifest 也无 uses-permission。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PiHostApp"
        android:allowBackup="false"
        android:label="pi host"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 库模块（core/engine）里的类，android:name 必须写全限定名 -->
        <service
            android:name="works.earendil.pihost.core.engine.PiEngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- API 34+ 对 specialUse 的强制申报：本机用途 = 本地 AI coding agent 引擎 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_ai_coding_agent_engine" />
        </service>
    </application>

</manifest>
