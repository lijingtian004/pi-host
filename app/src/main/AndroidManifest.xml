<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- P2C 引擎前台服务（方案 §3.5）：specialUse 类型 + API 33+ 的通知权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- P2F §4.3(a) 必修：normal 权限，安装期自动授予、无需运行时申请。
         没有它，pi 子进程调模型 API 的 socket 会被系统直接拒——spawn 修好了也过不了 P1 的「真实对话轮」判据。
         方向层 RECON-P2F §3.5 实测本清单此前只有上面 3 条，core/feature 各模块 Manifest 也无 uses-permission。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      备份面（规格书 P3A §3.4）。三条一起看：
      - `allowBackup="false"`：§1.6 实测的既有值，**P3A 不动它**——它是唯一真正生效的开关，
        API 31+ 上同时关掉云备份与设备转移。
      - `fullBackupContent`（API ≤ 30 读）/ `dataExtractionRules`（API ≥ 31 读）：两份清单都排除
        `home`（凭据：auth.json 的明文 key + models.json 的 apiKey）、`audit`（用户命令行原文与
        工具结果预览）、`crash`（绝对路径与完整栈）、`runtime`（100MB 级解压产物）。
      为什么在 false 之上还要留两份「暂时不生效」的清单：**纵深防御**。allowBackup 是产品决策
      而不是技术事实，将来若有人为了换机迁移体验把它翻成 true，这两份清单就是唯一还站在敏感目录
      前面的闸；翻标志的人不需要重新学一遍「哪几个目录不能带走」。这也是 §2 红线
      「凭据/API key 永不离开本机」在清单层的落点。
      （两个属性都不带 res/xml 之外的引用，不新增权限、不新增依赖。）
    -->
    <application
        android:name=".PiHostApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="pi host"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 库模块（core/engine）里的类，android:name 必须写全限定名 -->
        <service
            android:name="works.earendil.pihost.core.engine.PiEngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- API 34+ 对 specialUse 的强制申报：本机用途 = 本地 AI coding agent 引擎 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_ai_coding_agent_engine" />
        </service>
    </application>

</manifest>
